    <!-- KYC Intro Screen -->
    <string name="kyc_intro_button_text">உங்கள் KYC ஐ முடிக்கவும் →</string>
    <string name="kyc_intro_header_title">KYC</string>
    <string name="kyc_intro_title">உங்கள் KYC ஐ முடிக்கவும்</string>
    <string name="kyc_intro_subtitle">நிவேஷ் சன்சார் உடன் உங்கள் முதலீட்டுப் பயணத்தைத் தொடங்க சில படிகள் மட்டுமே.</string>
    <string name="kyc_intro_account_opening_fee">₹ 0 கணக்கு திறப்பு கட்டணம்</string>
    <string name="kyc_intro_account_opening_fee_subtitle">எந்தவித ஆரம்பச் செலவும் இல்லாமல் முதலீடு செய்யத் தொடங்குங்கள்.</string>
    <string name="kyc_intro_maintenance_charges">₹ 0 பராமரிப்பு கட்டணம்</string>
    <string name="kyc_intro_maintenance_charges_subtitle">மறைமுகக் கட்டணங்கள் இல்லை, நீங்கள் சம்பாதிப்பதை நீங்களே வைத்துக் கொள்ளுங்கள்.</string>
    <string name="kyc_intro_encrypted_data_title">உங்கள் தரவு என்க்ரிப்ட் செய்யப்பட்டு பாதுகாக்கப்பட்டுள்ளது</string>
    <string name="kyc_intro_encrypted_data_subtitle">உங்கள் தனிப்பட்ட தகவல்கள் முற்றிலும் ரகசியமாக இருப்பதை உறுதிசெய்ய வங்கி அளவிலான என்க்ரிப்ஷனைப் பயன்படுத்துகிறோம்.</string>

    <!-- KYC Contract Screen -->
    <string name="kyc_contract_complete_button">KYC ஐ முடிக்கவும்</string>
    <string name="kyc_contract_header_title">KYC உறுதிப்படுத்தல்</string>
    <string name="kyc_contract_view_doc_title">KYC ஆவணத்தைக் காண்க</string>
    <string name="kyc_contract_view_doc_subtitle">உங்கள் KYC சரிபார்ப்பு ஆவணத்தை முன்னோட்டமிட தட்டவும் மற்றும் அனைத்து தகவல்களும் சரியானதா என்பதை உறுதிப்படுத்தவும்.</string>
    <string name="kyc_contract_preview_button">ஆவணத்தை முன்னோட்டமிடு</string>
    <string name="kyc_contract_consent_text">நான் KYC ஆவணத்தைப் படித்துப் புரிந்துகொண்டேன், மேலும் வழங்கப்பட்ட விவரங்கள் துல்லியமானவை என்பதை உறுதிப்படுத்துகிறேன்.</string>

